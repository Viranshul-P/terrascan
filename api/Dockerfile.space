# Step 6.2: the TerraScan API on a Hugging Face Space (Docker). Built from the folder src/hf_space.py makes
# (data/hf_space/), not from the repo root. Same as api/Dockerfile, except the model is downloaded from the
# Hugging Face Hub (our model repo, pinned to one commit) instead of copied from this laptop's models/ folder.
FROM python:3.12.5-slim

WORKDIR /app

COPY api/requirements.txt api/requirements.txt
RUN pip install --no-cache-dir -r api/requirements.txt

COPY src/ src/
COPY api/ api/
COPY configs/ configs/
COPY results/imagery_calibration.json results/imagery_calibration.json

# Spaces run the app as user 1000, so the files are made readable for everyone.
ARG MODEL_REPO
ARG MODEL_REVISION
RUN mkdir -p models/efficientnet_b0_india/seed42 && python -c "import urllib.request as u; \
b='https://huggingface.co/${MODEL_REPO}/resolve/${MODEL_REVISION}/'; d='models/efficientnet_b0_india/seed42/'; \
[u.urlretrieve(b+f, d+f) for f in ('model.onnx', 'onnx_info.json')]" \
    && chmod -R a+rX models

# README.md says app_port 8000. CORS_ORIGINS (the website's address) is set as a Space variable.
EXPOSE 8000
CMD ["uvicorn", "api.main:default_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
