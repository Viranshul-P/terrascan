# Large files: never commit
data/*
!data/splits/
!data/stats.json
!data/bands_stats.json
models/
imagery/
*.tif
*.tiff
*.pt
*.pth
*.onnx

# Experiment tracking
wandb/

# Claude Code: keep .claude/ tracked, except local settings
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
.ipynb_checkpoints/

# Secrets
.env

# Impeccable design skill (5.3): downloaded engine binary and runtime caches stay local
.claude/skills/impeccable/scripts/bin/
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/skills/impeccable/scripts/config.json
.impeccable/live/
.impeccable/history/
.impeccable/config.local.json
.impeccable/critique/*
!.impeccable/critique/ignore.md

# Design review videos (5.3a): about 4 MB each, made again by `npm run shots:c` in web/
reports/design/**/*.webm

# Plain-English study notes for the user (kept local)
learn/
